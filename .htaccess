# Airport First — Apache / cPanel rules

# The mailer's spillover log holds guest contact details. It is normally
# written above the web root; this is the safety net if the host does not
# allow that and it lands here instead.
<FilesMatch "\.(log|sql|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Database config, shared PHP helpers and the schema are never served directly.
# (The real credentials live above public_html in ../airportfirst-db.php.)
<FilesMatch "^(db-config\.php|af-common\.php|schema\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# The admin page is never cached or framed by anything in between.
<Files "admin-reviews.php">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store"
        Header set X-Robots-Tag "noindex, nofollow"
    </IfModule>
</Files>

# Never expose the old Supabase files if that folder is uploaded.
RedirectMatch 404 ^/supabase/

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # The "Use my current location" button needs geolocation on this site.
    # Allowed for our own pages only. (A <meta> tag cannot set this policy.)
    Header always set Permissions-Policy "geolocation=(self)"
</IfModule>

# Long cache for static assets, none for the page itself.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png     "access plus 1 month"
    ExpiresByType text/html     "access plus 0 seconds"
</IfModule>
